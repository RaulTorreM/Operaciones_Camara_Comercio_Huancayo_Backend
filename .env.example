# ── Base de datos ────────────────────────────────────────────────────────────
# Base propia del backend de Operaciones (inventario + futuros módulos).
# En local:
ConnectionStrings__cch_operaciones=Host=localhost;Port=5432;Database=cch_operaciones;Username=postgres;Password=postgres
# En Railway también puedes usar DATABASE_URL:
# DATABASE_URL=postgresql://usuario:password@host:puerto/cch_operaciones

# ── JWT del inventario ───────────────────────────────────────────────────────
# Clave PROPIA del inventario (mínimo 32 caracteres). No usar la clave de la web.
Inventario__Jwt__Key=...
Inventario__Jwt__Issuer=CamaraComercio.Inventario
Inventario__Jwt__ExpireDays=7

# Dejar false en producción; aplicar migrations-inventory.sql a mano.
# En desarrollo, appsettings.Development.json lo pone en true.
Inventario__AutoMigrate=false

# Origen del frontend del inventario (CORS).
Inventario__FrontendURL=http://localhost:5173

# ── Usuario administrador inicial ───────────────────────────────────────────
# En producción es obligatorio definir ADMIN_PASSWORD (mínimo 8 caracteres).
# ADMIN_USER=admin
# ADMIN_PASSWORD=cambiame-en-produccion

# En producción los datos demo NO se cargan salvo que pongas SEED_DEMO=true.
# SEED_DEMO=false

# ── Cloudinary (fotos del inventario) ───────────────────────────────────────
Cloudinary__CloudName=...
Cloudinary__ApiKey=...
Cloudinary__ApiSecret=...
Cloudinary__Folder=camara-comercio-huancayo/inventario

# ── Usuarios adicionales (opcional) ─────────────────────────────────────────
# Inventario__SeedUsers__0__Username=gestor
# Inventario__SeedUsers__0__FullName=Gestor de inventario
# Inventario__SeedUsers__0__Role=ROLE_ADMIN
# Inventario__SeedUsers__0__Password=cambiame-en-produccion

# ── Módulo DailyTasks (pendientes diarios) ──────────────────────────────────
# Usa el MISMO PostgreSQL (cch_operaciones) pero su propio esquema `dailytasks`.
# JWT propio del módulo (mínimo 32 caracteres). No reutilizar la clave del inventario.
DailyTasks__Jwt__Key=...
DailyTasks__Jwt__Issuer=CamaraComercio.DailyTasks
DailyTasks__Jwt__ExpireDays=7

# Dejar false en producción; aplicar DailyTasks/migrations-dailytasks.sql a mano.
# En desarrollo, appsettings.Development.json lo pone en true.
DailyTasks__AutoMigrate=false

# Origen del frontend de pendientes (CORS).
DailyTasks__FrontendURL=http://localhost:5175

# Contraseña de respaldo: solo se usa si algún usuario de SeedUsers no define Password.
# En Development, si no se define, se usa demo1234.
DAILYTASKS_SEED_PASSWORD=cambiame-en-produccion

# En producción los pendientes demo NO se cargan salvo que pongas DAILYTASKS_SEED_DEMO=true.
# DAILYTASKS_SEED_DEMO=false

# Usuarios iniciales con credenciales ÚNICAS.
# Si defines DailyTasks__SeedUsers, debes incluir los 11 usuarios: reemplaza la lista por defecto.
# Cada usuario debe tener su propia contraseña (mínimo 8 caracteres).
# DailyTasks__SeedUsers__0__Username=milagros
# DailyTasks__SeedUsers__0__FullName=Milagros
# DailyTasks__SeedUsers__0__Area=GESTION_ASOCIADO
# DailyTasks__SeedUsers__0__Role=USER
# DailyTasks__SeedUsers__0__Password=una-clave-unica-para-milagros
# ... repetir para brizeth, arely, maria, maribel, johonny, patricia,
#     ginger, carmen, german y klaus (klaus con Role=MANAGER y Area=GERENCIA_GENERAL).

# Solo para aplicar las contraseñas del seed a usuarios que ya existen.
# Úsalo una vez y vuelve a false para no pisar cambios de contraseña.
# DAILYTASKS_SEED_UPDATE_PASSWORDS=false
